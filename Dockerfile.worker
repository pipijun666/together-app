FROM python:3.12-slim
WORKDIR /app
# Playwright browsers install to a fixed world-readable path so the non-root
# runtime user can find them (default ~/.cache would sit under /root).
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
COPY requirements.txt .
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates tini \
    && pip install --no-cache-dir -r requirements.txt \
    && python -m playwright install --with-deps chromium \
    && mkdir -p /ms-playwright && chmod -R a+rX /ms-playwright \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 together
COPY common.py link_input.py worker.py ./
COPY adapters ./adapters
USER together
# tini reaps Playwright/Chromium children so they do not accumulate as zombies
# under this container's PID 1 (previously `python worker.py`).
ENTRYPOINT ["tini", "--"]
CMD ["python", "worker.py"]
