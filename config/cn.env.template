# 国内单机 app 环境模板（DB-001）：把真实值复制到私有根目录 .env，禁止提交真实文件。
# 所有口令/令牌留占位符；部署前用 operations/deployment_preflight.py --role primary 校验。
HOST=0.0.0.0
PORT=8765
COOKIE_SECURE=1
NODE_ROLE=primary
MAX_MEDIA_BYTES=10737418240
# Set to 1 only after nginx has the internal __together_* media locations.
MEDIA_X_ACCEL=1
# Optional Gemini translation API key & proxy configuration
# GEMINI_API_KEY=
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
WORKER_TOKEN=replace-with-at-least-32-random-characters
HOTSPOT_SERVICE_TOKEN=replace-with-a-different-at-least-32-random-characters
USER_ONE_NAME=replace-me
USER_ONE_PASSWORD=replace-with-at-least-12-characters
USER_TWO_NAME=replace-me
USER_TWO_PASSWORD=replace-with-at-least-12-characters
